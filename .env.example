# ─────────────────────────────────────────────
# N-Guard Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── Runtime profile ──────────────────────────
NODE_ENV=development
# NODE_ENV=production

# ── CAP / CDS ────────────────────────────────
PORT=4004
# CDS_LOG_LEVELS_DB=debug

# ── SQLite (development only) ────────────────
SQLITE_DB_PATH=./db/nguard.db

# ── SAP AI Core / Generative AI Hub ──────────
# Used when NODE_ENV=production or AI_PROVIDER=aicore
AI_PROVIDER=mock
# AI_PROVIDER=aicore

# SAP AI Core service binding (BTP)
# AICORE_SERVICE_URL=https://api.ai.prodeu.aws.ai-foundation.cloud.sap/v2
# AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_RESOURCE_GROUP=default

# Generative AI Hub model
# AICORE_MODEL_NAME=gpt-4o
# AICORE_EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Store ─────────────────────────────
VECTOR_STORE=mock
# VECTOR_STORE=hana

# ── SAP HANA Cloud (production) ──────────────
# HANA_HOST=
# HANA_PORT=443
# HANA_USER=
# HANA_PASSWORD=
# HANA_DATABASE=

# ── XSUAA (production) ───────────────────────
# XSUAA_URL=
# XSUAA_CLIENT_ID=
# XSUAA_CLIENT_SECRET=
