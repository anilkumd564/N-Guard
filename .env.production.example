# N-Guard — Production Environment Variables
# Copy this file to .env (never commit .env to git)
# Replace ALL placeholder values before deployment.
#
# On SAP BTP Cloud Foundry, these values are provided automatically
# via VCAP_SERVICES bindings (xsuaa, hana, aicore, destination).
# This file is for reference and for VM/on-premise deployments.

# ─── Node / CAP ───────────────────────────────────────────────────────────────
NODE_ENV=production
CDS_ENV=production
PORT=4004

# ─── SAP AI Core (Generative AI Hub) ─────────────────────────────────────────
# The client credentials are provided by the AI Core service binding on BTP.
# For VM deployments, obtain these from the AI Core service key in BTP Cockpit.
AICORE_CLIENT_ID=<replace-with-ai-core-client-id>
AICORE_CLIENT_SECRET=<replace-with-ai-core-client-secret>
AICORE_AUTH_URL=<replace-with-ai-core-token-url>
AICORE_BASE_URL=<replace-with-ai-core-api-base-url>
AICORE_DEPLOYMENT_ID=<replace-with-deployment-id>
AICORE_MODEL_NAME=gpt-4o

# ─── SAP HANA Cloud ───────────────────────────────────────────────────────────
# Provided automatically via VCAP_SERVICES.hana on BTP.
# For local HANA testing (not required for development — uses SQLite).
# HANA_HOST=<replace-with-hana-host>
# HANA_PORT=443
# HANA_USER=<replace-with-hana-user>
# HANA_PASSWORD=<replace-with-hana-password>
# HANA_SCHEMA=<replace-with-hdi-container-schema>

# ─── XSUAA ────────────────────────────────────────────────────────────────────
# Provided automatically via VCAP_SERVICES.xsuaa on BTP.
# For VM deployments:
# XSUAA_URL=<replace-with-xsuaa-url>
# XSUAA_CLIENT_ID=<replace-with-xsuaa-client-id>
# XSUAA_CLIENT_SECRET=<replace-with-xsuaa-client-secret>

# ─── SAP Destination Service ──────────────────────────────────────────────────
# Provided automatically via VCAP_SERVICES.destination on BTP.
# Destinations configure the targets for IntegrationProvider adapters.

# ─── Optional: External Integrations ─────────────────────────────────────────
# Only set these if the integrations are enabled. Leave unset otherwise.
# Health checker returns NOT_CONFIGURED automatically for unset targets.

# SHAREPOINT_SITE_URL=<replace-with-sharepoint-site-url>
# SHAREPOINT_CLIENT_ID=<replace-with-entra-app-client-id>
# SHAREPOINT_CLIENT_SECRET=<replace-with-entra-app-client-secret>
# SHAREPOINT_TENANT_ID=<replace-with-entra-tenant-id>

# AZURE_DEVOPS_ORG=<replace-with-ado-organization>
# AZURE_DEVOPS_PAT=<replace-with-personal-access-token>

# SAP_CLOUD_ALM_URL=<replace-with-cloud-alm-url>
# SAP_CLOUD_ALM_CLIENT_ID=<replace-with-cloud-alm-oauth-client-id>
# SAP_CLOUD_ALM_CLIENT_SECRET=<replace-with-cloud-alm-oauth-client-secret>

# S4HANA_BASE_URL=<replace-with-s4hana-odata-base-url>
# S4HANA_CLIENT_ID=<replace-with-s4hana-oauth-client-id>
# S4HANA_CLIENT_SECRET=<replace-with-s4hana-oauth-client-secret>

# SIGNAVIO_TENANT_ID=<replace-with-signavio-tenant-id>
# SIGNAVIO_API_TOKEN=<replace-with-signavio-api-token>

# JIRA_BASE_URL=<replace-with-jira-base-url>
# JIRA_API_TOKEN=<replace-with-jira-api-token>
# JIRA_USER_EMAIL=<replace-with-jira-user-email>

# ─── Security Guards ──────────────────────────────────────────────────────────
# Override defaults from agent/src/security/types.ts
MAX_INGEST_FILE_BYTES=10485760
MAX_PROMPT_CHARS=32000
