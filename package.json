{
  "name": "n-guard",
  "version": "0.1.0",
  "description": "N-Guard — AI-powered fit-to-standard compliance agent for SAP S/4HANA",
  "private": true,
  "workspaces": [
    "app",
    "agent"
  ],
  "scripts": {
    "start": "cds-ts serve",
    "dev": "cds-ts watch",
    "dev:app": "npm run dev --workspace=app",
    "build": "npm run build:srv && npm run build:agent && npm run build:app",
    "build:srv": "tsc -p srv/tsconfig.json",
    "build:agent": "npm run build --workspace=agent",
    "build:app": "npm run build --workspace=app",
    "test": "npm run test:srv && npm run test:agent",
    "test:srv": "jest --config jest.config.ts --passWithNoTests",
    "test:agent": "npm run test --workspace=agent",
    "lint": "eslint \"srv/src/**/*.ts\" \"agent/src/**/*.ts\" \"app/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"srv/src/**/*.ts\" \"agent/src/**/*.ts\" \"app/src/**/*.{ts,tsx}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"srv/src/**/*.ts\" \"agent/src/**/*.ts\" \"app/src/**/*.{ts,tsx}\" \"*.{json,md,mjs}\"",
    "typecheck": "tsc --noEmit -p srv/tsconfig.json && npm run typecheck --workspace=agent && npm run typecheck --workspace=app",
    "deploy:sqlite": "cds deploy --to sqlite:db/n-guard-dev.db"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@n-guard/agent": "*",
    "@sap/cds": "^10.1.1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0",
    "@eslint/js": "^9",
    "@sap/cds-dk": "^10",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "jest": "^29",
    "prettier": "^3",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "cds": {
    "features": {
      "typescript": true
    }
  }
}
